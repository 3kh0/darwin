# local dev, these work out of the box with docker-compose.override.yml, no need to change em

APP_PUBLIC_URL=http://localhost:3000
ESMBOT_PASS=dev-secret
ESMBOT_WS_URL=ws://localhost:3762/sock
ESMBOT_HTTP_URL=http://localhost:3762
MEDIA_SECRET=dev-media-secret

# prod values, pls set these to the proper things

# APP_PUBLIC_URL=https://your-domain.com
# ESMBOT_PASS=change-me-strong-random-secret
# API_KEYS=key1,key2,key3          # optional, empty = all access
# MEDIA_SECRET=change-me-another-random-secret
