{
  "name": "darwin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bun run --filter @darwin/web dev",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "build": "bun run --filter @darwin/web build",
    "preview": "bun run --filter @darwin/web preview",
    "test": "bun run --filter @darwin/web test"
  },
  "workspaces": [
    "apps/*"
  ]
}
